ARCLIGHT_ENVIRONMENT=development
ARCLIGHT_DATABASE_URL=postgresql+psycopg://arclight:arclight@localhost:5432/arclight
ARCLIGHT_CHECKPOINT_URL=postgresql://arclight:arclight@localhost:5432/arclight
ARCLIGHT_REDIS_URL=redis://localhost:6379/0
ARCLIGHT_PROVIDER=mock
# 文本时长允许范围为目标时长 ±此百分比（整数 0–100），默认 10。
ARCLIGHT_TEXT_DURATION_TOLERANCE_PERCENT=10
# 新任务的上下文上限；API 与 workflow worker 使用同一配置，重试沿用启动时的上限。
ARCLIGHT_CONTEXT_LIMITS={"max_bytes":262144,"max_assets":64,"max_story_entries":100,"neighbor_radius":1,"max_history":5}
ARCLIGHT_MEDIA_LEASE_SECONDS=60
ARCLIGHT_MEDIA_HEARTBEAT_SECONDS=10
ARCLIGHT_MEDIA_POLL_SECONDS=30
ARCLIGHT_MEDIA_EXECUTION_POLICY={"provider_concurrency":4,"project_concurrency":2,"global_per_minute":60,"user_per_minute":20,"call_timeout_seconds":60,"max_elapsed_seconds":900,"max_attempts":3,"retry_base_seconds":2,"retry_max_seconds":60}
# 开发令牌仅适用于本地演示，生产禁用此入口，只接受用户会话。
ARCLIGHT_API_TOKEN=local-development-token-change-me
# openai_compatible 模式需要以下配置；禁止将真实密钥提交到 Git。
ARCLIGHT_LLM_API_KEY=
ARCLIGHT_LLM_BASE_URL=https://api.openai.com/v1
ARCLIGHT_LLM_MODEL=gpt-4.1-mini
# 服务器连接的供应商与结构化输出协议；custom / json_schema 保持旧配置兼容。
ARCLIGHT_LLM_SUPPLIER=custom
ARCLIGHT_LLM_RESPONSE_FORMAT=json_schema
ARCLIGHT_LLM_DNS_TIMEOUT_SECONDS=5
# 网关治理策略，API/Worker 共用；模型连接仍使用上面三项或账号配置快照。
# 文字服务按用户的连接配置直接调用，无需配置报价；服务商余额不足时返回对应提示。
# 未提供实际费用时显示“未统计”，旧 text_maximum_cost / pricing_version 字段保留读取兼容。
ARCLIGHT_MODEL_GATEWAY_POLICY={"global_per_minute":600,"user_per_minute":120,"failure_threshold":3,"cooldown_seconds":60,"max_attempts":1,"timeout_seconds":60}

# 生产环境必须设置独立的随机 JWT 密钥（至少 32 字符）。
ARCLIGHT_JWT_SECRET=arclight-local-jwt-secret-change-before-deploying
# TLS 终止部署需显式填写外部 HTTPS Origin（JSON 数组）。
ARCLIGHT_AUTH_ALLOWED_ORIGINS=[]
ARCLIGHT_ALLOW_REGISTRATION=true

# 账号模型配置密钥：使用 cryptography.fernet.Fernet.generate_key() 生成，保持稳定并安全备份。
# 未配置时仍可保存无密钥预设，但禁止保存 API Key。不要提交真实值。
ARCLIGHT_SERVICE_ENCRYPTION_KEY=
# 生产可注入只读 Secret 文件（仅含 Fernet 主密钥）；与上面的直接值二选一。
ARCLIGHT_SERVICE_ENCRYPTION_KEY_FILE=
# 轮换期间的只读旧密钥列表（JSON），或由独立 Secret 文件提供同样的 JSON 数组。
ARCLIGHT_SERVICE_ENCRYPTION_PREVIOUS_KEYS=[]
ARCLIGHT_SERVICE_ENCRYPTION_PREVIOUS_KEYS_FILE=
# 自定义供应商无需域名白名单。出站只允许公网 HTTPS/443，逐次解析并固定 IP，拒绝重定向和环境代理。
# 网络侧仍须阻断内网、元数据和私网 NAT/代理路由；恢复/轮换操作见 docs/model-service-operations.md。

# 本机人工图片版本的私有目录；Compose API使用独立命名卷，不向Web静态目录暴露。
ARCLIGHT_ASSET_STORAGE_PATH=./.local/asset-objects
# Standalone local mode remains available; Compose defaults to private S3.
ARCLIGHT_OBJECT_STORAGE_BACKEND=s3
ARCLIGHT_S3_ENDPOINT_URL=http://127.0.0.1:9000
# Standalone API/transfer processes use the same gateway secret. Production: random, >=32 chars.
ARCLIGHT_FILE_GATEWAY_SECRET=local-file-gateway-change-before-deploying
# Relative URL for Compose/Nginx; standalone clients can use http://localhost:8081/file-transfers.
ARCLIGHT_FILE_TRANSFER_BASE_URL=/file-transfers
ARCLIGHT_FILE_GATEWAY_API_URL=http://127.0.0.1:8000
ARCLIGHT_S3_BUCKET=arclight-media
ARCLIGHT_S3_ACCESS_KEY=arclight-local
ARCLIGHT_S3_SECRET_KEY=arclight-local-storage-change-me
